# ── 构建产物 ────────────────────────────────────────────
# 整个 build/ 都不入库。构建目录是【可再生产物】——
# 有 CMakeLists.txt 就能重建，没必要存，而且每次改代码它都变，
# 进了历史就再也删不干净。
build/
cmake-build-*/

# 编译中间产物（如果哪天在源码目录里直接编译）
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.exe

# 可执行文件（防止有人直接在源码目录构建）
myapp

# ── 编辑器 / 语言工具 ───────────────────────────────────
# compile_commands.json 是 CMake 生成的（我们开了 CMAKE_EXPORT_COMPILE_COMMANDS）
# 它的内容包含【绝对路径】，换台机器就没用了
compile_commands.json

# clangd 的索引缓存
.cache/
.vscode/

# ── 系统 ────────────────────────────────────────────────
.DS_Store
